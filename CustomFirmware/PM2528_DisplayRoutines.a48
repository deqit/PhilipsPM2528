;****************************************************************************************
; The 7-segment table lives in page 3, so MOVP3 can read it from code in any page.
        .DO *>$0300
        .ER F,Code before SevenSegmentDisplayBitPatterns runs past $0300
        .FI
        .no $0300
SevenSegmentDisplayBitPatterns
        .db %01111111   (blank)
        .db %01000000   '0'
        .db %01111001   '1'
        .db %00100100   '2'
        .db %00110000   '3'
        .db %00011001   '4'
        .db %00010010   '5'
        .db %00000010   '6'
        .db %01111000   '7'
        .db %00000000   '8'
        .db %00010000   '9'
        .db %00001000   'A'
        .db %00000011   'b'
        .db %01000110   'C'
        .db %00100001   'd'
        .db %00000110   'E'
        .db %00001110   'F'

PgStart .EQ SevenSegmentDisplayBitPatterns/$100  ; MOVP3 A,@A always reads page 3
PgEnd   .EQ *-1/$100
        .DO PgStart!=3
        .ER F,SevenSegmentDisplayBitPatterns must start in page 3 (MOVP3)
        .FI
        .DO PgEnd!=3
        .ER F,SevenSegmentDisplayBitPatterns runs past the end of page 3
        .FI

;**********************
Lookup7SegmentCodeForDigit
        INC        A
        ANL        A,#%00001111 ; for now only the first few characters
        ADD        A,#SevenSegmentDisplayBitPatterns\256 ; offset within page 3
        MOVP3      A,@A                                  ; always reads page 3, from any page
        RET

;**********************
Update7SegmentDisplay
        MOV        A,#%10111111                                   Select N2, /PS2, Digit 0
        OUTL       P2,A
        MOV        A,R7
        CALL Update7SegmentDigit
        MOV        A,#%10101111                                  Select N2, /PS2, Digit 1
        OUTL       P2,A
        MOV        A,R6
        CALL Update7SegmentDigit
        MOV        A,#%10011111
        OUTL       P2,A                                           Select N2, /PS2, Digit 2,3
        MOV        A,R5
        CALL Update7SegmentDigit
        MOV        A,R4
        CALL Update7SegmentDigit
        MOV        A,#%10001111
        OUTL       P2,A                                           Select N2, /PS2, Digit 4,5
        MOV        A,R3
        CALL Update7SegmentDigit
        MOV        A,R2
        CALL Update7SegmentDigit
        ANL        P2,#%00001111                                  Deselect all IO-expanders (D170x, N2)
        RET


;**********************
Update7SegmentDigit
        MOV R1,#$08
.loopDigit
        MOVD P4,A
        RR   A
        DJNZ R1,.loopDigit
        RET


